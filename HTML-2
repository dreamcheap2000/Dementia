    <h1>Summary &amp; Key Takeaways</h1>
    <div style="max-width:700px;margin-top:20px;text-align:left;">
      <div class="cards cards-3">
        <div class="card">
          <h3>🧠 Neuroimaging</h3>
          <ul class="check">
            <li>MRI hippocampal atrophy = earliest AD marker</li>
            <li>DaTSCAN separates DLB from AD with &gt;85% specificity</li>
            <li>DWI cortical ribboning is pathognomonic for CJD</li>
            <li>Amyloid PET required for anti-amyloid therapy eligibility</li>
          </ul>
        </div>
        <div class="card">
          <h3>🔬 Clinical Features</h3>
          <ul class="check">
            <li>Memory-first = AD; Executive-first = VaD/bvFTD</li>
            <li>RBD + VH + fluctuation = DLB until proven otherwise</li>
            <li>Rapid progression + myoclonus → exclude CJD</li>
            <li>Gait + incontinence + dementia triad = consider NPH</li>
          </ul>
        </div>
        <div class="card">
          <h3>🤖 AI</h3>
          <ul class="check">
            <li>DL on MRI/PET achieves &gt;92% AUC for AD classification</li>
            <li>Plasma p-tau217 AI models match CSF performance</li>
            <li>Speech AI enables remote, scalable early detection</li>
            <li>Equity and explainability are essential for clinical adoption</li>
          </ul>
        </div>
      </div>
    </div>
    <p class="author-line" style="margin-top:24px;">
      For clinical use, consult current NIA-AA, DLB Consortium, NICE, and AAN guidelines.<br/>
      All AI tools require local validation before clinical deployment.
    </p>
  </div>
</div>

</div><!-- /slides -->

<!-- NAVIGATION -->
<div id="nav">
  <button id="prev-btn" disabled>← Prev</button>
  <div style="display:flex;align-items:center;gap:12px;">
    <button id="toc-btn">☰ Contents</button>
    <span id="slide-counter">1 / 27</span>
  </div>
  <button id="next-btn">Next →</button>
</div>

<!-- TOC MODAL -->
<div id="toc-modal">
  <div id="toc-inner">
    <h2>Table of Contents</h2>
    <div id="toc-list"></div>
    <button style="margin-top:16px;padding:8px 20px;background:var(--accent);color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:.9rem;" onclick="document.getElementById('toc-modal').classList.remove('open')">Close</button>
  </div>
</div>

<script>
(function(){
  const slides = Array.from(document.querySelectorAll('.slide'));
  let cur = 0;

  // Build TOC
  const tocList = document.getElementById('toc-list');
  slides.forEach((s,i) => {
    const label = s.dataset.toc || ('Slide '+(i+1));
    const item = document.createElement('div');
    item.className = 'toc-item';
    item.innerHTML = `<div class="toc-num">${i+1}</div><div class="toc-label">${label}</div>`;
    item.addEventListener('click', () => { goTo(i); document.getElementById('toc-modal').classList.remove('open'); });
    tocList.appendChild(item);
  });

  function goTo(n){
    slides[cur].classList.remove('active');
    slides[cur].classList.add('exit');
    setTimeout(()=>{ slides[cur].classList.remove('exit'); cur=n; slides[cur].classList.add('active'); updateUI(); }, 250);
    // instant for same-slide
    if(n===cur){ slides[cur].classList.remove('exit'); slides[cur].classList.add('active'); updateUI(); return; }
    slides[cur].classList.remove('active');
    slides[cur].classList.add('exit');
    setTimeout(()=>{ slides[cur].classList.remove('exit'); cur=n; slides[cur].scrollTop=0; slides[cur].classList.add('active'); updateUI(); },300);
  }

  function updateUI(){
    document.getElementById('slide-counter').textContent = (cur+1)+' / '+slides.length;
    document.getElementById('prev-btn').disabled = cur===0;
    document.getElementById('next-btn').disabled = cur===slides.length-1;
    const pct = slides.length>1 ? ((cur/(slides.length-1))*100) : 100;
    document.getElementById('progress-bar').style.width = pct+'%';
  }

  document.getElementById('prev-btn').addEventListener('click',()=>{ if(cur>0) goTo(cur-1); });
  document.getElementById('next-btn').addEventListener('click',()=>{ if(cur<slides.length-1) goTo(cur+1); });
  document.getElementById('toc-btn').addEventListener('click',()=>{ document.getElementById('toc-modal').classList.toggle('open'); });
  document.getElementById('toc-modal').addEventListener('click',function(e){ if(e.target===this) this.classList.remove('open'); });

  // Keyboard
  document.addEventListener('keydown',e=>{
    if(e.key==='ArrowRight'||e.key==='ArrowDown') { if(cur<slides.length-1) goTo(cur+1); }
    if(e.key==='ArrowLeft'||e.key==='ArrowUp') { if(cur>0) goTo(cur-1); }
    if(e.key==='Escape') document.getElementById('toc-modal').classList.remove('open');
  });

  // Touch swipe
  let tx=0;
  document.addEventListener('touchstart',e=>{ tx=e.touches[0].clientX; },{passive:true});
  document.addEventListener('touchend',e=>{
    const dx=e.changedTouches[0].clientX-tx;
    if(Math.abs(dx)>60){ if(dx<0&&cur<slides.length-1) goTo(cur+1); else if(dx>0&&cur>0) goTo(cur-1); }
  },{passive:true});

  updateUI();
})();
</script>
</body>
</html>
